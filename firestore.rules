rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────────────

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user matches document ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user is an admin (Custom Claim or adminRoles collection)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == "sleephigh31@gmail.com" ||
        exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid))
      );
    }

    // ─── Collection Rules ─────────────────────────────────────────────────────

    // Admin roles collection (Strict admin only)
    match /adminRoles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Cart subcollection
      match /cart/{lineId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Wishlist subcollection
      match /wishlist/{productId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Products collection
    // allow list (collection queries) for all — active filtering is done via query where clauses
    // allow get (single doc reads) for active products or admin
    match /products/{productId} {
      allow list: if true;
      allow get: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Categories collection
    // allow list for all — active filtering is done via query where clauses
    match /categories/{categoryId} {
      allow list: if true;
      allow get: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if true; // Guests & auth users can place orders
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if resource.data.status == "approved" || isAdmin();
      allow create: if true; // Customers can submit reviews (pending by default)
      allow update, delete: if isAdmin();
    }

    // Coupons collection
    match /coupons/{couponId} {
      allow read: if isAuthenticated() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if true; // Public store info (name, shipping rates, social links)
      allow write: if isAdmin();
    }

    // Homepage layout collection
    match /homepage/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin Audit Logs collection
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Admin Notifications collection
    match /notifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    // Site Messages collection (Contact Form)
    // Public users can submit messages; only admins can read/update/delete
    match /site_messages/{messageId} {
      allow create: if true; // Anyone can submit a contact form message
      allow read, update, delete: if isAdmin();
    }
  }
}
